{
  "name": "lan-laser-pen",
  "version": "0.1.0",
  "private": true,
  "description": "Turn your phone into a LAN presentation pointer with a touchpad, motion controls and a transparent Windows overlay.",
  "keywords": [
    "laser-pointer",
    "presentation",
    "touchpad",
    "websocket",
    "lan",
    "windows",
    "harmonyos",
    "iphone"
  ],
  "author": "Fu Xing",
  "contributors": ["SilentTiger (https://github.com/SilentTiger)"],
  "license": "MIT",
  "homepage": "https://github.com/fuxing0910-hue/lan-laser-pen#readme",
  "bugs": "https://github.com/fuxing0910-hue/lan-laser-pen/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/fuxing0910-hue/lan-laser-pen.git"
  },
  "scripts": {
    "start": "node scripts/build.cjs demo && node server.cjs",
    "serve": "node server.cjs",
    "dev": "webpack serve",
    "build": "node scripts/build.cjs demo",
    "build:library": "node scripts/build.cjs production",
    "build:demo": "node scripts/build.cjs demo",
    "test": "node scripts/test.cjs",
    "overlay": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/overlay.ps1",
    "lint": "npx eslint ./src/**/*.ts ./example/*.ts",
    "lint:fix": "npx eslint ./src/**/*.ts  ./example/*.ts --fix"
  },
  "devDependencies": {
    "@types/bezier-js": "^4.1.0",
    "@types/qrcode": "^1.4.2",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "bezier-js": "^5.1.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^10.2.4",
    "eslint": "^8.0.0",
    "eslint-config-alloy": "^4.3.0",
    "html-webpack-plugin": "^5.3.2",
    "prettier": "^2.4.1",
    "qrcode": "^1.5.0",
    "ts-loader": "^9.2.6",
    "typescript": "^4.4.3",
    "webpack": "^5.58.1",
    "webpack-bundle-analyzer": "^4.4.2",
    "webpack-cli": "^4.9.0",
    "webpack-dev-server": "^4.3.1"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "engines": { "node": ">=22" },
  "packageManager": "npm@11.13.0"
}
